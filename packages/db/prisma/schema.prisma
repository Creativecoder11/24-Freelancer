  ownerUserId                    String?                   @db.Uuid @map("owner_user_id")
  ownerAdminId                   String?                   @db.Uuid @map("owner_admin_id")
  purpose                        UploadPurpose
  status                         UploadStatus              @default(pending)
  storageBucket                  String                    @db.VarChar(63) @map("storage_bucket")
  storageKey                     String?                   @db.VarChar(512) @map("storage_key")
  storageKeyEnc                  Bytes?                    @map("storage_key_enc")
  originalFilename               String                    @db.VarChar(255) @map("original_filename")
  mimeType                       String                    @db.VarChar(100) @map("mime_type")
  sizeBytes                      Int                       @map("size_bytes")
  sha256                         Bytes?
  phash                          BigInt?
  widthPx                        Int?                      @map("width_px")
  heightPx                       Int?                      @map("height_px")
  completedAt                    DateTime?                 @db.Timestamptz(6) @map("completed_at")
  deleteAfter                    DateTime?                 @db.Timestamptz(6) @map("delete_after")
  deletedAt                      DateTime?                 @db.Timestamptz(6) @map("deleted_at")
  createdAt                      DateTime                  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt                      DateTime                  @default(now()) @db.Timestamptz(6) @map("updated_at")
  appeals                        Appeal[]
  disputes                       Dispute[] @relation("DisputeEvidence1")
  disputesEvidence2              Dispute[] @relation("DisputeEvidence2")
  disputesEvidence3              Dispute[] @relation("DisputeEvidence3")
  employerProfiles               EmployerProfile[]
  kycVerificationsByBackUpload   KycVerification[]         @relation("kyc_verifications_back_upload_idTouploads")
  kycVerificationsByFrontUpload  KycVerification[]         @relation("kyc_verifications_front_upload_idTouploads")
  kycVerificationsBySelfieUpload KycVerification[]         @relation("kyc_verifications_selfie_upload_idTouploads")
  ledgerAdjustmentRequests       LedgerAdjustmentRequest[]
  submissionProofItems           SubmissionProofItem[]
  ownerAdmin                     AdminUser?                @relation(fields: [ownerAdminId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "uploads_owner_admin_fk")
  ownerUser                      User?                     @relation("uploads_owner_user_idTousers", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "uploads_owner_user_fk")
  usersByAvatarUpload            User[]                    @relation("users_avatar_upload_idTouploads")

  @@index([ownerUserId, purpose], map: "uploads_owner_idx")
  @@map("uploads")
}

model UserInterest {
  userId     String   @db.Uuid @map("user_id")
  categoryId String   @db.Uuid @map("category_id")
  createdAt  DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, categoryId])
  @@index([categoryId], map: "user_interests_category_idx")
  @@map("user_interests")
}

model User {
  id                                String                   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  publicId                          String                   @unique @db.VarChar(9) @map("public_id")
  fullName                          String?                  @db.VarChar(80) @map("full_name")
  email                             String?                  @unique @db.Citext
  emailVerifiedAt                   DateTime?                @db.Timestamptz(6) @map("email_verified_at")
  emailStatus                       String                   @default("ok") @db.VarChar(12) @map("email_status")
  phoneE164                         String?                  @unique @db.VarChar(16) @map("phone_e164")
  phoneVerifiedAt                   DateTime?                @db.Timestamptz(6) @map("phone_verified_at")
  passwordHash                      String?                  @db.VarChar(255) @map("password_hash")
  passwordChangedAt                 DateTime?                @db.Timestamptz(6) @map("password_changed_at")
  countryCode                       String                   @default("BD") @db.Char(2) @map("country_code")
  status                            UserStatus               @default(active)
  activeMode                        ActiveMode               @default(worker) @map("active_mode")
  defaultMode                       ActiveMode               @default(worker) @map("default_mode")
  signupRole                        ActiveMode               @default(worker) @map("signup_role")
  referralCode                      String?                  @db.VarChar(12) @map("referral_code")
  avatarUploadId                    String?                  @db.Uuid @map("avatar_upload_id")
  twoStepEnabled                    Boolean                  @default(false) @map("two_step_enabled")
  withdrawalPasswordRequired        Boolean                  @default(true) @map("withdrawal_password_required")
  emailDigestEnabled                Boolean                  @default(true) @map("email_digest_enabled")
  kycStatus                         KycStatus                @default(not_submitted) @map("kyc_status")
  kycVerifiedAt                     DateTime?                @db.Timestamptz(6) @map("kyc_verified_at")
  onboardingStep                    Int                      @default(1) @db.SmallInt @map("onboarding_step")
  onboardingCompletedAt             DateTime?                @db.Timestamptz(6) @map("onboarding_completed_at")
  termsAcceptedAt                   DateTime                 @db.Timestamptz(6) @map("terms_accepted_at")
  termsVersion                      String                   @db.VarChar(20) @map("terms_version")
  signupIp                          String?                  @db.Inet @map("signup_ip")
  lastLoginAt                       DateTime?                @db.Timestamptz(6) @map("last_login_at")
  failedLoginCount                  Int                      @default(0) @db.SmallInt @map("failed_login_count")
  lockedUntil                       DateTime?                @db.Timestamptz(6) @map("locked_until")
  closedAt                          DateTime?                @db.Timestamptz(6) @map("closed_at")
  anonymisedAt                      DateTime?                @db.Timestamptz(6) @map("anonymised_at")
  setupCardDismissedAt              DateTime?                @db.Timestamptz(6) @map("setup_card_dismissed_at")
  createdAt                         DateTime                 @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt                         DateTime                 @default(now()) @db.Timestamptz(6) @map("updated_at")
  accountRestrictions               AccountRestriction[]
  appeals                           Appeal[]
  auditLogs                         AuditLog[]
  authSessions                      AuthSession[]
  contactMessages                   ContactMessage[]
  deposits                          Deposit[]
  disputesByEmployerUser            Dispute[]                @relation("disputes_employer_user_idTousers")
  disputesByWorkerUser              Dispute[]                @relation("disputes_worker_user_idTousers")
  employerProfile                   EmployerProfile?
  jobReports                        JobReport[]
  jobViews                          JobView[]
  jobs                              Job[]
  kycVerifications                  KycVerification[]
  ledgerTransactions                LedgerTransaction[]
  notificationPreferences           NotificationPreference[]
  notifications                     Notification[]
  otpChallenges                     OtpChallenge[]
  passwordHistories                 PasswordHistory[]
  payoutMethods                     PayoutMethod[]
  referralCommissionsByReferredUser ReferralCommission[]     @relation("referral_commissions_referred_user_idTousers")
  referralCommissionsByReferrerUser ReferralCommission[]     @relation("referral_commissions_referrer_user_idTousers")
  referralByReferredUser            Referral?                @relation("referrals_referred_user_idTousers")
  referralsByReferrerUser           Referral[]               @relation("referrals_referrer_user_idTousers")
  slotReservations                  SlotReservation[]
  submissionEvents                  SubmissionEvent[]
  submissionsByDecidedByUser        Submission[]             @relation("submissions_decided_by_user_idTousers")
  submissionsByEmployerUser         Submission[]             @relation("submissions_employer_user_idTousers")
  submissionsByWorkerUser           Submission[]             @relation("submissions_worker_user_idTousers")
  uploadsByOwnerUser                Upload[]                 @relation("uploads_owner_user_idTousers")
  userInterests                     UserInterest[]
  avatarUpload                      Upload?                  @relation("users_avatar_upload_idTouploads", fields: [avatarUploadId], references: [id], onUpdate: NoAction)
  walletAccounts                    WalletAccount[]
  withdrawalEvents                  WithdrawalEvent[]
  withdrawalQuotes                  WithdrawalQuote[]
  withdrawals                       Withdrawal[]
  workerProfile                     WorkerProfile?

  trustedDevices                    TrustedDevice[]
  @@index([createdAt])
  @@index([fullName(ops: raw("gin_trgm_ops"))], map: "users_full_name_trgm", type: Gin)
  @@map("users")
}

model WalletAccount {
  id                       String                    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  ownerUserId              String?                   @db.Uuid @map("owner_user_id")
  kind                     WalletAccountKind
  systemCode               String?                   @unique @db.VarChar(60) @map("system_code")
  currency                 String                    @default("USD") @db.Char(3)
  isSystem                 Boolean?                  @default(dbgenerated("(owner_user_id IS NULL)")) @map("is_system")
  balanceCached            Decimal                   @default(0) @db.Decimal(20, 6) @map("balance_cached")
  allowNegative            Boolean                   @default(false) @map("allow_negative")
  lastEntryAt              DateTime?                 @db.Timestamptz(6) @map("last_entry_at")
  version                  BigInt                    @default(0)
  createdAt                DateTime                  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt                DateTime                  @default(now()) @db.Timestamptz(6) @map("updated_at")
  ledgerAdjustmentRequests LedgerAdjustmentRequest[]
  ledgerEntries            LedgerEntry[]
  payoutMethodConfigs      PayoutMethodConfig[]
  ownerUser                User?                     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("wallet_accounts")
}

model WithdrawalEvent {
  id           String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  withdrawalId String            @db.Uuid @map("withdrawal_id")
  fromStatus   WithdrawalStatus? @map("from_status")
  toStatus     WithdrawalStatus  @map("to_status")
  actorType    ActorType         @map("actor_type")
  actorUserId  String?           @db.Uuid @map("actor_user_id")
  actorAdminId String?           @db.Uuid @map("actor_admin_id")
  note         String?           @db.VarChar(300)
  data         Json              @default("{}")
  occurredAt   DateTime          @default(now()) @db.Timestamptz(6) @map("occurred_at")
  actorAdmin   AdminUser?        @relation(fields: [actorAdminId], references: [id], onUpdate: NoAction)
  actorUser    User?             @relation(fields: [actorUserId], references: [id], onUpdate: NoAction)
  withdrawal   Withdrawal        @relation(fields: [withdrawalId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([withdrawalId, occurredAt], map: "wd_events_wd_idx")
  @@map("withdrawal_events")
}

model Withdrawal {
  id                             String                @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  publicRef                      String                @unique @default(dbgenerated("fmt_ref('WD-'::text, nextval('withdrawal_ref_seq'::regclass), 5)")) @db.VarChar(12) @map("public_ref")
  userId                         String                @db.Uuid @map("user_id")
  payoutMethodId                 String                @db.Uuid @map("payout_method_id")
  quoteId                        String?               @db.Uuid @map("quote_id")
  batchId                        String?               @db.Uuid @map("batch_id")
  method                         PayoutMethodType
  destinationMasked              String                @db.VarChar(40) @map("destination_masked")
  destinationEncrypted           Bytes                 @map("destination_encrypted")
  keyId                          String                @db.VarChar(120) @map("key_id")
  amountUsd                      Decimal               @db.Decimal(20, 6) @map("amount_usd")
  feeUsd                         Decimal               @default(0) @db.Decimal(20, 6) @map("fee_usd")
  netUsd                         Decimal?              @default(dbgenerated("(amount_usd - fee_usd)")) @db.Decimal(20, 6) @map("net_usd")
  payoutCurrency                 String                @db.Char(4) @map("payout_currency")
  exchangeRateId                 String?               @db.Uuid @map("exchange_rate_id")
  fxRate                         Decimal               @db.Decimal(20, 6) @map("fx_rate")
  payoutAmount                   Decimal               @db.Decimal(20, 6) @map("payout_amount")
  status                         WithdrawalStatus      @default(requested)
  requestedAt                    DateTime              @default(now()) @db.Timestamptz(6) @map("requested_at")
  holdUntil                      DateTime?             @db.Timestamptz(6) @map("hold_until")
  processingAt                   DateTime?             @db.Timestamptz(6) @map("processing_at")
  paidAt                         DateTime?             @db.Timestamptz(6) @map("paid_at")
  rejectedAt                     DateTime?             @db.Timestamptz(6) @map("rejected_at")
  cancelledAt                    DateTime?             @db.Timestamptz(6) @map("cancelled_at")
  failedAt                       DateTime?             @db.Timestamptz(6) @map("failed_at")
  rejectReasonCode               String?               @db.VarChar(30) @map("reject_reason_code")
  rejectReasonText               String?               @db.VarChar(300) @map("reject_reason_text")
  riskFlags                      String[]              @default([]) @map("risk_flags")
  providerTrxId                  String?               @db.VarChar(120) @map("provider_trx_id")
  processedByAdminId             String?               @db.Uuid @map("processed_by_admin_id")
  requestLedgerTxId              String                @db.Uuid @map("request_ledger_tx_id")
  settleLedgerTxId               String?               @db.Uuid @map("settle_ledger_tx_id")
  reversalLedgerTxId             String?               @db.Uuid @map("reversal_ledger_tx_id")
  createdAt                      DateTime              @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt                      DateTime              @default(now()) @db.Timestamptz(6) @map("updated_at")
  ledgerTransactionsByWithdrawal LedgerTransaction[]   @relation("ledger_transactions_withdrawal_idTowithdrawals")
  paymentWebhookEvents           PaymentWebhookEvent[]
  withdrawalEvents               WithdrawalEvent[]
  batch                          WithdrawalBatche?     @relation(fields: [batchId], references: [id], onUpdate: NoAction, map: "wd_batch_fk")
  quote                          WithdrawalQuote?      @relation(fields: [quoteId], references: [id], onUpdate: NoAction, map: "wd_quote_fk")
  exchangeRate                   ExchangeRate?         @relation(fields: [exchangeRateId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payoutMethod                   PayoutMethod          @relation(fields: [payoutMethodId], references: [id], onUpdate: NoAction)
  processedByAdmin               AdminUser?            @relation(fields: [processedByAdminId], references: [id], onUpdate: NoAction)
  requestLedgerTx                LedgerTransaction     @relation("withdrawals_request_ledger_tx_idToledger_transactions", fields: [requestLedgerTxId], references: [id], onUpdate: NoAction)
  reversalLedgerTx               LedgerTransaction?    @relation("withdrawals_reversal_ledger_tx_idToledger_transactions", fields: [reversalLedgerTxId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  settleLedgerTx                 LedgerTransaction?    @relation("withdrawals_settle_ledger_tx_idToledger_transactions", fields: [settleLedgerTxId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user                           User                  @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([userId, requestedAt(sort: Desc)], map: "wd_user_list_idx")
  @@index([userId, status], map: "wd_user_status_idx")
  @@map("withdrawals")
}

model WorkerProfile {
  userId            String          @id @db.Uuid @map("user_id")
  interestTime      InterestTime?   @map("interest_time")
  interestDevice    InterestDevice? @map("interest_device")
  approvalRatePct   Int?            @db.SmallInt @map("approval_rate_pct")
  approved30d       Int             @default(0) @map("approved_30d")
  rejected30d       Int             @default(0) @map("rejected_30d")
  approvedTotal     Int             @default(0) @map("approved_total")
  statsRefreshedAt  DateTime?       @db.Timestamptz(6) @map("stats_refreshed_at")
  firstWithdrawalAt DateTime?       @db.Timestamptz(6) @map("first_withdrawal_at")
  createdAt         DateTime        @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt         DateTime        @default(now()) @db.Timestamptz(6) @map("updated_at")
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([approvalRatePct], map: "worker_profiles_rate_idx")
  @@map("worker_profiles")
}

model LedgerAdjustmentRequest {
  id               String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  accountId        String             @db.Uuid @map("account_id")
  amount           Decimal            @db.Decimal(20, 6)
  reasonCode       String             @db.VarChar(30) @map("reason_code")
  internalNote     String             @db.VarChar(1000) @map("internal_note")
  visibleText      String             @db.VarChar(120) @map("visible_text")
  evidenceUploadId String?            @db.Uuid @map("evidence_upload_id")
  status           String             @default("pending_approval") @db.VarChar(20)
  createdByAdminId String             @db.Uuid @map("created_by_admin_id")
  decidedByAdminId String?            @db.Uuid @map("decided_by_admin_id")
  decidedAt        DateTime?          @db.Timestamptz(6) @map("decided_at")
  decisionNote     String?            @db.VarChar(500) @map("decision_note")
  ledgerTxId       String?            @db.Uuid @map("ledger_tx_id")
  expiresAt        DateTime           @db.Timestamptz(6) @map("expires_at")
  createdAt        DateTime           @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime           @default(now()) @db.Timestamptz(6) @map("updated_at")
  account          WalletAccount      @relation(fields: [accountId], references: [id], onUpdate: NoAction)
  createdByAdmin   AdminUser          @relation("ledger_adjustment_requests_created_by_admin_idToadmin_users", fields: [createdByAdminId], references: [id], onUpdate: NoAction)
  decidedByAdmin   AdminUser?         @relation("ledger_adjustment_requests_decided_by_admin_idToadmin_users", fields: [decidedByAdminId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  evidenceUpload   Upload?            @relation(fields: [evidenceUploadId], references: [id], onUpdate: NoAction)
  ledgerTx         LedgerTransaction? @relation(fields: [ledgerTxId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("ledger_adjustment_requests")
}

model ProviderSettlementLine {
  id                String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  settlementId      String             @db.Uuid @map("settlement_id")
  provider          String             @db.VarChar(40)
  providerPaymentId String             @db.VarChar(120) @map("provider_payment_id")
  grossAmount       Decimal            @db.Decimal(20, 6) @map("gross_amount")
  feeAmount         Decimal            @default(0) @db.Decimal(20, 6) @map("fee_amount")
  netAmount         Decimal            @db.Decimal(20, 6) @map("net_amount")
  currency          String             @db.VarChar(10)
  settledOn         DateTime           @db.Date @map("settled_on")
  depositId         String?            @db.Uuid @map("deposit_id")
  matchStatus       String             @default("unmatched") @db.VarChar(20) @map("match_status")
  ledgerTxId        String?            @db.Uuid @map("ledger_tx_id")
  raw               Json               @default("{}")
  createdAt         DateTime           @default(now()) @db.Timestamptz(6) @map("created_at")
  deposit           Deposit?           @relation(fields: [depositId], references: [id], onUpdate: NoAction)
  ledgerTx          LedgerTransaction? @relation(fields: [ledgerTxId], references: [id], onDelete: Restrict, onUpdate: NoAction)

