generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccountRestriction {
  id               String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId           String          @db.Uuid @map("user_id")
  kind             RestrictionKind
  reasonCode       String          @db.VarChar(40) @map("reason_code")
  internalNote     String?         @db.VarChar(1000) @map("internal_note")
  publicMessage    String          @db.VarChar(300) @map("public_message")
  startsAt         DateTime        @default(now()) @db.Timestamptz(6) @map("starts_at")
  endsAt           DateTime?       @db.Timestamptz(6) @map("ends_at")
  createdByAdminId String          @db.Uuid @map("created_by_admin_id")
  liftedAt         DateTime?       @db.Timestamptz(6) @map("lifted_at")
  liftedByAdminId  String?         @db.Uuid @map("lifted_by_admin_id")
  createdAt        DateTime        @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime        @default(now()) @db.Timestamptz(6) @map("updated_at")
  createdByAdmin   AdminUser       @relation("account_restrictions_created_by_admin_idToadmin_users", fields: [createdByAdminId], references: [id], onUpdate: NoAction)
  liftedByAdmin    AdminUser?      @relation("account_restrictions_lifted_by_admin_idToadmin_users", fields: [liftedByAdminId], references: [id], onUpdate: NoAction)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appeals          Appeal[]

  @@map("account_restrictions")
}

model AdminPendingAction {
  id               String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  action           String    @db.VarChar(60)
  objectType       String    @db.VarChar(40) @map("object_type")
  objectId         String    @db.Uuid @map("object_id")
  payload          Json      @default("{}")
  reason           String    @db.VarChar(500)
  idempotencyKey   String    @db.VarChar(100) @map("idempotency_key")
  status           String    @default("pending") @db.VarChar(20)
  createdByAdminId String    @db.Uuid @map("created_by_admin_id")
  decidedByAdminId String?   @db.Uuid @map("decided_by_admin_id")
  decidedAt        DateTime? @db.Timestamptz(6) @map("decided_at")
  decisionNote     String?   @db.VarChar(500) @map("decision_note")
  createdAt        DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime  @default(now()) @db.Timestamptz(6) @map("updated_at")
  createdByAdmin   AdminUser  @relation("admin_pending_actions_created_by_admin_idToadmin_users", fields: [createdByAdminId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  decidedByAdmin   AdminUser? @relation("admin_pending_actions_decided_by_admin_idToadmin_users", fields: [decidedByAdminId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("admin_pending_actions")
}

model AdminRole {
  id             String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code           String          @unique @db.VarChar(30)
  name           String          @db.VarChar(60)
  description    String          @db.VarChar(300)
  permissions    String[]        @default([])
  createdAt      DateTime        @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt      DateTime        @default(now()) @db.Timestamptz(6) @map("updated_at")
  adminUserRoles AdminUserRole[]

  @@map("admin_roles")
}

model AdminSession {
  id               String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  adminUserId      String    @db.Uuid @map("admin_user_id")
  refreshTokenHash Bytes     @unique @map("refresh_token_hash")
  familyId         String    @db.Uuid @map("family_id")
  ipAddress        String?   @db.Inet @map("ip_address")
  userAgent        String?   @db.VarChar(512) @map("user_agent")
  lastActiveAt     DateTime  @default(now()) @db.Timestamptz(6) @map("last_active_at")
  reauthAt         DateTime? @db.Timestamptz(6) @map("reauth_at")
  expiresAt        DateTime  @db.Timestamptz(6) @map("expires_at")
  revokedAt        DateTime? @db.Timestamptz(6) @map("revoked_at")
  revokedReason    String?   @db.VarChar(40) @map("revoked_reason")
  createdAt        DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime  @default(now()) @db.Timestamptz(6) @map("updated_at")
  adminUser        AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([familyId], map: "admin_sessions_family_idx")
  @@map("admin_sessions")
}

model AdminUserRole {
  adminUserId      String     @db.Uuid @map("admin_user_id")
  adminRoleId      String     @db.Uuid @map("admin_role_id")
  grantedByAdminId String?    @db.Uuid @map("granted_by_admin_id")
  grantedAt        DateTime   @default(now()) @db.Timestamptz(6) @map("granted_at")
  adminRole        AdminRole  @relation(fields: [adminRoleId], references: [id], onUpdate: NoAction)
  adminUser        AdminUser  @relation("admin_user_roles_admin_user_idToadmin_users", fields: [adminUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  grantedByAdmin   AdminUser? @relation("admin_user_roles_granted_by_admin_idToadmin_users", fields: [grantedByAdminId], references: [id], onUpdate: NoAction)

  @@id([adminUserId, adminRoleId])
  @@index([adminRoleId], map: "admin_user_roles_role_idx")
  @@map("admin_user_roles")
}

model AdminUser {
  id                                       String                    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email                                    String                    @unique @db.Citext
  fullName                                 String                    @db.VarChar(80) @map("full_name")
  passwordHash                             String                    @db.VarChar(255) @map("password_hash")
  totpSecretEnc                            Bytes?                    @map("totp_secret_enc")
  totpEnrolledAt                           DateTime?                 @db.Timestamptz(6) @map("totp_enrolled_at")
  mustChangePassword                       Boolean                   @default(false) @map("must_change_password")
  status                                   AdminUserStatus           @default(active)
  lastLoginAt                              DateTime?                 @db.Timestamptz(6) @map("last_login_at")
  failedLoginCount                         Int                       @default(0) @db.SmallInt @map("failed_login_count")
  lockedUntil                              DateTime?                 @db.Timestamptz(6) @map("locked_until")
  createdByAdminId                         String?                   @db.Uuid @map("created_by_admin_id")
  createdAt                                DateTime                  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt                                DateTime                  @default(now()) @db.Timestamptz(6) @map("updated_at")
  accountRestrictionsByCreatedByAdmin      AccountRestriction[]      @relation("account_restrictions_created_by_admin_idToadmin_users")
  accountRestrictionsByLiftedByAdmin       AccountRestriction[]      @relation("account_restrictions_lifted_by_admin_idToadmin_users")
  adminUserRolesByAdminUser                AdminUserRole[]           @relation("admin_user_roles_admin_user_idToadmin_users")
  adminUserRolesByGrantedByAdmin           AdminUserRole[]           @relation("admin_user_roles_granted_by_admin_idToadmin_users")
  createdByAdmin                           AdminUser?                @relation("admin_usersToadmin_users", fields: [createdByAdminId], references: [id], onUpdate: NoAction)
  adminUsersByCreatedByAdmin               AdminUser[]               @relation("admin_usersToadmin_users")
  appeals                                  Appeal[]
  auditLogs                                AuditLog[]
  contactMessages                          ContactMessage[]
  disputesByAssignedAdmin                  Dispute[]                 @relation("disputes_assigned_admin_idToadmin_users")
  disputesByResolvedByAdmin                Dispute[]                 @relation("disputes_resolved_by_admin_idToadmin_users")
  exchangeRates                            ExchangeRate[]
  faqs                                     Faq[]
  helpArticles                             HelpArticle[]
  jobReports                               JobReport[]
  jobs                                     Job[]
  kycVerifications                         KycVerification[]
  ledgerAdjustmentRequestsByCreatedByAdmin LedgerAdjustmentRequest[] @relation("ledger_adjustment_requests_created_by_admin_idToadmin_users")
  ledgerAdjustmentRequestsByDecidedByAdmin LedgerAdjustmentRequest[] @relation("ledger_adjustment_requests_decided_by_admin_idToadmin_users")
  ledgerTransactionsByApprovedByAdmin      LedgerTransaction[]       @relation("ledger_transactions_approved_by_admin_idToadmin_users")
  ledgerTransactionsByCreatedByAdmin       LedgerTransaction[]       @relation("ledger_transactions_created_by_admin_idToadmin_users")
  legalPages                               LegalPage[]
  payoutMethodConfigs                      PayoutMethodConfig[]
  platformSettings                         PlatformSetting[]
  reconciliationItems                      ReconciliationItem[]
  submissionEvents                         SubmissionEvent[]
  submissions                              Submission[]
  uploads                                  Upload[]
  withdrawalBatches                        WithdrawalBatche[]
  withdrawalEvents                         WithdrawalEvent[]
  withdrawals                              Withdrawal[]

  adminSessions                            AdminSession[]
  adminPendingActionsByCreatedByAdmin      AdminPendingAction[]      @relation("admin_pending_actions_created_by_admin_idToadmin_users")
  adminPendingActionsByDecidedByAdmin      AdminPendingAction[]      @relation("admin_pending_actions_decided_by_admin_idToadmin_users")
  supportReplies                           SupportReply[]
  @@map("admin_users")
}

model Appeal {
  id               String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId           String             @db.Uuid @map("user_id")
  restrictionId    String             @db.Uuid @map("restriction_id")
  message          String             @db.VarChar(1000)
  evidenceUploadId String?            @db.Uuid @map("evidence_upload_id")
  status           AppealStatus       @default(open)
  decidedByAdminId String?            @db.Uuid @map("decided_by_admin_id")
  decisionNote     String?            @db.VarChar(500) @map("decision_note")
  decidedAt        DateTime?          @db.Timestamptz(6) @map("decided_at")
  createdAt        DateTime           @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime           @default(now()) @db.Timestamptz(6) @map("updated_at")
  decidedByAdmin   AdminUser?         @relation(fields: [decidedByAdminId], references: [id], onUpdate: NoAction)
  evidenceUpload   Upload?            @relation(fields: [evidenceUploadId], references: [id], onUpdate: NoAction)
  restriction      AccountRestriction @relation(fields: [restrictionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("appeals")
}

model AuditLog {
  id           String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  actorType    ActorType  @map("actor_type")
  actorAdminId String?    @db.Uuid @map("actor_admin_id")
  actorUserId  String?    @db.Uuid @map("actor_user_id")
  action       String     @db.VarChar(80)
  entityType   String     @db.VarChar(40) @map("entity_type")
  entityId     String?    @db.Uuid @map("entity_id")
  entityRef    String?    @db.VarChar(20) @map("entity_ref")
  reason       String?    @db.VarChar(500)
  beforeData   Json?      @map("before_data")
  afterData    Json?      @map("after_data")
  ipAddress    String?    @db.Inet @map("ip_address")
  userAgent    String?    @db.VarChar(512) @map("user_agent")
  requestId    String?    @db.VarChar(64) @map("request_id")
  createdAt    DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")
  actorAdmin   AdminUser? @relation(fields: [actorAdminId], references: [id], onUpdate: NoAction)
  actorUser    User?      @relation(fields: [actorUserId], references: [id], onUpdate: NoAction)

  @@index([actorAdminId, createdAt(sort: Desc)], map: "audit_admin_idx")
  @@index([createdAt], map: "audit_created_idx")
  @@index([entityType, entityId, createdAt(sort: Desc)], map: "audit_entity_idx")
  @@map("audit_logs")
}

model AuthSession {
  id               String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId           String    @db.Uuid @map("user_id")
  refreshTokenHash Bytes     @unique @map("refresh_token_hash")
  familyId         String    @db.Uuid @map("family_id")
  keepSignedIn     Boolean   @default(false) @map("keep_signed_in")
  deviceLabel      String?   @db.VarChar(120) @map("device_label")
  userAgent        String?   @db.VarChar(512) @map("user_agent")
  ipAddress        String?   @db.Inet @map("ip_address")
  city             String?   @db.VarChar(80)
  lastActiveAt     DateTime  @default(now()) @db.Timestamptz(6) @map("last_active_at")
  expiresAt        DateTime  @db.Timestamptz(6) @map("expires_at")
  revokedAt        DateTime? @db.Timestamptz(6) @map("revoked_at")
  revokedReason    String?   @db.VarChar(40) @map("revoked_reason")
  createdAt        DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime  @default(now()) @db.Timestamptz(6) @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "auth_sessions_expires_idx")
  @@index([familyId], map: "auth_sessions_family_idx")
  @@map("auth_sessions")
}

model Category {
  id            String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  slug          String         @unique @db.VarChar(40)
  name          String         @db.VarChar(60)
  sortOrder     Int            @default(0) @db.SmallInt @map("sort_order")
  isPublic      Boolean        @default(true) @map("is_public")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt     DateTime       @default(now()) @db.Timestamptz(6) @map("updated_at")
  jobs          Job[]
  userInterests UserInterest[]

  @@map("categories")
}

model ContactMessage {
  id              String               @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId          String?              @db.Uuid @map("user_id")
  fullName        String               @db.VarChar(80) @map("full_name")
  email           String               @db.Citext
  topic           ContactTopic
  accountPublicId String?              @db.VarChar(9) @map("account_public_id")
  message         String               @db.VarChar(300)
  consentAt       DateTime             @db.Timestamptz(6) @map("consent_at")
  status          ContactMessageStatus @default(new)
  assignedAdminId String?              @db.Uuid @map("assigned_admin_id")
  answeredAt      DateTime?            @db.Timestamptz(6) @map("answered_at")
  ipAddress       String?              @db.Inet @map("ip_address")
  userAgent       String?              @db.VarChar(512) @map("user_agent")
  createdAt       DateTime             @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt       DateTime             @default(now()) @db.Timestamptz(6) @map("updated_at")
  assignedAdmin   AdminUser?           @relation(fields: [assignedAdminId], references: [id], onUpdate: NoAction)
  user            User?                @relation(fields: [userId], references: [id], onUpdate: NoAction)

  replies           SupportReply[]
  @@index([email], map: "contact_email_idx")
  @@map("contact_messages")
}

model Deposit {
  id                          String                   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  publicRef                   String                   @unique @default(dbgenerated("fmt_ref('DP-'::text, nextval('deposit_ref_seq'::regclass), 5)")) @db.VarChar(12) @map("public_ref")
  employerUserId              String                   @db.Uuid @map("employer_user_id")
  method                      DepositMethod
  provider                    String                   @db.VarChar(40)
  providerPaymentId           String?                  @db.VarChar(120) @map("provider_payment_id")
  providerAsset               String?                  @db.VarChar(20) @map("provider_asset")
  amountUsd                   Decimal                  @db.Decimal(20, 6) @map("amount_usd")
  amountReceivedUsd           Decimal?                 @db.Decimal(20, 6) @map("amount_received_usd")
  creditedAmountUsd           Decimal?                 @db.Decimal(20, 6) @map("credited_amount_usd")
  providerFee                 Decimal?                 @db.Decimal(20, 6) @map("provider_fee")
  fxRate                      Decimal?                 @db.Decimal(20, 6) @map("fx_rate")
  chargeAmountBdt             Decimal?                 @db.Decimal(20, 2) @map("charge_amount_bdt")
  payCurrency                 String?                  @db.VarChar(10) @map("pay_currency")
  payAmount                   Decimal?                 @db.Decimal(30, 10) @map("pay_amount")
  network                     String?                  @db.VarChar(20)
  txHash                      String?                  @db.VarChar(120) @map("tx_hash")
  confirmations               Int?
  needsReview                 Boolean                  @default(false) @map("needs_review")
  status                      DepositStatus            @default(initiated)
  checkoutUrl                 String?                  @db.VarChar(2048) @map("checkout_url")
  expiresAt                   DateTime?                @db.Timestamptz(6) @map("expires_at")
  initiatedAt                 DateTime                 @default(now()) @db.Timestamptz(6) @map("initiated_at")
  completedAt                 DateTime?                @db.Timestamptz(6) @map("completed_at")
  failedAt                    DateTime?                @db.Timestamptz(6) @map("failed_at")
  failureReason               String?                  @db.VarChar(300) @map("failure_reason")
  creditLedgerTxId            String?                  @db.Uuid @map("credit_ledger_tx_id")
  settledAt                   DateTime?                @db.Timestamptz(6) @map("settled_at")
  settlementId                String?                  @db.Uuid @map("settlement_id")
  refundedAmountUsd           Decimal                  @default(0) @db.Decimal(20, 6) @map("refunded_amount_usd")
  refundedAt                  DateTime?                @db.Timestamptz(6) @map("refunded_at")
  refundLedgerTxId            String?                  @db.Uuid @map("refund_ledger_tx_id")
  createdAt                   DateTime                 @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt                   DateTime                 @default(now()) @db.Timestamptz(6) @map("updated_at")
  creditLedgerTx              LedgerTransaction?       @relation("deposits_credit_ledger_tx_idToledger_transactions", fields: [creditLedgerTxId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  employerUser                User                     @relation(fields: [employerUserId], references: [id], onUpdate: NoAction)
  refundLedgerTx              LedgerTransaction?       @relation("deposits_refund_ledger_tx_idToledger_transactions", fields: [refundLedgerTxId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  ledgerTransactionsByDeposit LedgerTransaction[]      @relation("ledger_transactions_deposit_idTodeposits")
  paymentWebhookEvents        PaymentWebhookEvent[]
  providerSettlementLines     ProviderSettlementLine[]
  referralCommissions         ReferralCommission[]

  @@index([employerUserId, initiatedAt(sort: Desc)], map: "dep_employer_idx")
  @@map("deposits")
}

model Dispute {
  id                          String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  publicRef                   String              @unique @default(dbgenerated("fmt_ref('DS-'::text, nextval('dispute_ref_seq'::regclass), 5)")) @db.VarChar(12) @map("public_ref")
  submissionId                String              @unique @db.Uuid @map("submission_id")
  workerUserId                String              @db.Uuid @map("worker_user_id")
  employerUserId              String              @db.Uuid @map("employer_user_id")
  status                      DisputeStatus       @default(open)
  disputedDecision            SubmissionStatus    @map("disputed_decision")
  workerStatement             String              @db.VarChar(1000) @map("worker_statement")
  evidenceUploadId            String?             @db.Uuid @map("evidence_upload_id")
  evidenceUpload2Id           String?             @db.Uuid @map("evidence_upload_2_id")
  evidenceUpload3Id           String?             @db.Uuid @map("evidence_upload_3_id")
  openedAt                    DateTime            @default(now()) @db.Timestamptz(6) @map("opened_at")
  slaDueAt                    DateTime            @db.Timestamptz(6) @map("sla_due_at")
  assignedAdminId             String?             @db.Uuid @map("assigned_admin_id")
  underReviewAt               DateTime?           @db.Timestamptz(6) @map("under_review_at")
  resolvedAt                  DateTime?           @db.Timestamptz(6) @map("resolved_at")
  resolvedByAdminId           String?             @db.Uuid @map("resolved_by_admin_id")
  resolutionNote              String?             @db.VarChar(1000) @map("resolution_note")
  withdrawnAt                 DateTime?           @db.Timestamptz(6) @map("withdrawn_at")
  payoutLedgerTxId            String?             @db.Uuid @map("payout_ledger_tx_id")
  createdAt                   DateTime            @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt                   DateTime            @default(now()) @db.Timestamptz(6) @map("updated_at")
  payoutLedgerTx              LedgerTransaction?  @relation("disputes_payout_ledger_tx_idToledger_transactions", fields: [payoutLedgerTxId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "dispute_payout_tx_fk")
  assignedAdmin               AdminUser?          @relation("disputes_assigned_admin_idToadmin_users", fields: [assignedAdminId], references: [id], onUpdate: NoAction)
  employerUser                User                @relation("disputes_employer_user_idTousers", fields: [employerUserId], references: [id], onUpdate: NoAction)
  evidenceUpload              Upload?             @relation("DisputeEvidence1", fields: [evidenceUploadId], references: [id], onUpdate: NoAction)
  evidenceUpload2             Upload?             @relation("DisputeEvidence2", fields: [evidenceUpload2Id], references: [id], onUpdate: NoAction)
  evidenceUpload3             Upload?             @relation("DisputeEvidence3", fields: [evidenceUpload3Id], references: [id], onUpdate: NoAction)
  resolvedByAdmin             AdminUser?          @relation("disputes_resolved_by_admin_idToadmin_users", fields: [resolvedByAdminId], references: [id], onUpdate: NoAction)
  submission                  Submission          @relation(fields: [submissionId], references: [id], onUpdate: NoAction)
  workerUser                  User                @relation("disputes_worker_user_idTousers", fields: [workerUserId], references: [id], onUpdate: NoAction)
  ledgerTransactionsByDispute LedgerTransaction[] @relation("ledger_transactions_dispute_idTodisputes")

  @@index([workerUserId, openedAt(sort: Desc)], map: "disputes_worker_idx")
  @@map("disputes")
}

model EmployerProfile {
  userId                   String    @id @db.Uuid @map("user_id")
  businessName             String    @db.VarChar(80) @map("business_name")
  websiteUrl               String?   @db.VarChar(255) @map("website_url")
  industry                 String?   @db.VarChar(60)
  billingEmail             String?   @db.Citext @map("billing_email")
  about                    String?   @db.VarChar(300)
  logoUploadId             String?   @db.Uuid @map("logo_upload_id")
  verificationStatus       EmployerVerificationStatus @default(not_submitted) @map("verification_status")
  verificationSubmittedAt  DateTime? @db.Timestamptz(6) @map("verification_submitted_at")
  employerVerifiedAt       DateTime? @db.Timestamptz(6) @map("employer_verified_at")
  verificationNote         String?   @db.VarChar(500) @map("verification_note")
  defaultReviewWindowHours Int       @default(72) @db.SmallInt @map("default_review_window_hours")
  defaultMinApprovalRate   Int       @default(80) @db.SmallInt @map("default_min_approval_rate")
  defaultAutoApprove       Boolean   @default(true) @map("default_auto_approve")
  defaultAllowResubmission Boolean   @default(true) @map("default_allow_resubmission")
  defaultPauseOnLowDeposit Boolean   @default(true) @map("default_pause_on_low_deposit")
  approvalRatePct          Int?      @db.SmallInt @map("approval_rate_pct")
  avgReviewSeconds         Int?      @map("avg_review_seconds")
  jobsPostedCount          Int       @default(0) @map("jobs_posted_count")
  statsRefreshedAt         DateTime? @db.Timestamptz(6) @map("stats_refreshed_at")
  receivableUsd             Decimal                   @default(0) @db.Decimal(20, 6) @map("receivable_usd")
  createdAt                DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt                DateTime  @default(now()) @db.Timestamptz(6) @map("updated_at")
  logoUpload               Upload?   @relation(fields: [logoUploadId], references: [id], onUpdate: NoAction)
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([businessName(ops: raw("gin_trgm_ops"))], map: "employer_profiles_name_trgm", type: Gin)
  @@map("employer_profiles")
}

model ExchangeRate {
  id               String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  baseCurrency     String            @default("USD") @db.Char(3) @map("base_currency")
  quoteCurrency    String            @db.Char(4) @map("quote_currency")
  direction        String            @default("payout") @db.VarChar(8)
  rate             Decimal           @db.Decimal(20, 6)
  source           String            @default("manual") @db.VarChar(20)
  marginPercent    Decimal           @default(0) @db.Decimal(7, 4) @map("margin_percent")
  effectiveFrom    DateTime          @default(now()) @db.Timestamptz(6) @map("effective_from")
  createdByAdminId String?           @db.Uuid @map("created_by_admin_id")
  note             String?           @db.VarChar(200)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6) @map("created_at")
  createdByAdmin   AdminUser?        @relation(fields: [createdByAdminId], references: [id], onUpdate: NoAction)
  withdrawalQuotes WithdrawalQuote[]
  withdrawals      Withdrawal[]

  @@unique([quoteCurrency, direction, effectiveFrom], map: "fx_effective_uq")
  @@index([quoteCurrency, direction, effectiveFrom(sort: Desc)], map: "fx_current_idx")
  @@map("exchange_rates")
}

model Faq {
  id               String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  question         String     @db.VarChar(200)
  answerMd         String     @map("answer_md")
  placements       String[]
  sortOrder        Int        @default(0) @db.SmallInt @map("sort_order")
  isPublished      Boolean    @default(false) @map("is_published")
  updatedByAdminId String?    @db.Uuid @map("updated_by_admin_id")
  createdAt        DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime   @default(now()) @db.Timestamptz(6) @map("updated_at")
  updatedByAdmin   AdminUser? @relation(fields: [updatedByAdminId], references: [id], onUpdate: NoAction)

  @@index([placements], map: "faqs_placement_gin", type: Gin)
  @@map("faqs")
}

model HelpArticle {
  id               String                   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  topicId          String                   @db.Uuid @map("topic_id")
  slug             String                   @db.VarChar(120)
  title            String                   @db.VarChar(160)
  summary          String?                  @db.VarChar(300)
  bodyMd           String                   @map("body_md")
  isPopular        Boolean                  @default(false) @map("is_popular")
  popularLabel     String?                  @db.VarChar(40) @map("popular_label")
  sortOrder        Int                      @default(0) @db.SmallInt @map("sort_order")
  publishedAt      DateTime?                @db.Timestamptz(6) @map("published_at")
  updatedByAdminId String?                  @db.Uuid @map("updated_by_admin_id")
  searchTsv        Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, (COALESCE(title, ''::character varying))::text), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(body_md, ''::text)), 'B'::\"char\"))")) @map("search_tsv")
  createdAt        DateTime                 @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime                 @default(now()) @db.Timestamptz(6) @map("updated_at")
  topic            HelpTopic                @relation(fields: [topicId], references: [id], onUpdate: NoAction)
  updatedByAdmin   AdminUser?               @relation(fields: [updatedByAdminId], references: [id], onUpdate: NoAction)

  @@unique([topicId, slug], map: "help_article_slug_uq")
  @@index([searchTsv], map: "help_articles_search_gin", type: Gin)
  @@map("help_articles")
}

model HelpTopic {
  id           String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  slug         String        @unique @db.VarChar(60)
  title        String        @db.VarChar(60)
  description  String        @db.VarChar(160)
  contactTopic ContactTopic? @map("contact_topic")
  sortOrder    Int           @default(0) @db.SmallInt @map("sort_order")
  isPublished  Boolean       @default(true) @map("is_published")
  createdAt    DateTime      @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt    DateTime      @default(now()) @db.Timestamptz(6) @map("updated_at")
  helpArticles HelpArticle[]

  @@map("help_topics")
}

model IdempotencyKey {
  id           String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  actorType    ActorType         @map("actor_type")
  actorId      String            @db.Uuid @map("actor_id")
  key          String            @db.VarChar(80)
  method       String            @db.VarChar(8)
  path         String            @db.VarChar(300)
  requestHash  Bytes             @map("request_hash")
  status       IdempotencyStatus @default(in_progress)
  responseCode Int?              @db.SmallInt @map("response_code")
  responseBody Json?             @map("response_body")
  lockedUntil  DateTime          @db.Timestamptz(6) @map("locked_until")
  createdAt    DateTime          @default(now()) @db.Timestamptz(6) @map("created_at")
  expiresAt    DateTime          @db.Timestamptz(6) @map("expires_at")

  @@unique([actorType, actorId, key], map: "idem_key_uq")
  @@index([expiresAt], map: "idem_expires_idx")
  @@map("idempotency_keys")
}

model JobProofRequirement {
  id                   String                @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  jobId                String                @db.Uuid @map("job_id")
  position             Int                   @db.SmallInt
  proofType            ProofType             @map("proof_type")
  title                String                @db.VarChar(80)
  fieldLabel           String?               @db.VarChar(60) @map("field_label")
  helper               String?               @db.VarChar(200)
  isRequired           Boolean               @default(true) @map("is_required")
  createdAt            DateTime              @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt            DateTime              @default(now()) @db.Timestamptz(6) @map("updated_at")
  job                  Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  submissionProofItems SubmissionProofItem[]

  @@unique([jobId, position], map: "job_proof_position_uq")
  @@index([proofType, jobId], map: "job_proof_type_idx")
  @@map("job_proof_requirements")
}

model JobReport {
  id               String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  jobId            String          @db.Uuid @map("job_id")
  reporterUserId   String          @db.Uuid @map("reporter_user_id")
  reason           JobReportReason
  details          String?         @db.VarChar(300)
  status           JobReportStatus @default(open)
  handledByAdminId String?         @db.Uuid @map("handled_by_admin_id")
  handledAt        DateTime?       @db.Timestamptz(6) @map("handled_at")
  resolutionNote   String?         @db.VarChar(500) @map("resolution_note")
  createdAt        DateTime        @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime        @default(now()) @db.Timestamptz(6) @map("updated_at")
  handledByAdmin   AdminUser?      @relation(fields: [handledByAdminId], references: [id], onUpdate: NoAction)
  job              Job             @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reporterUser     User            @relation(fields: [reporterUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([jobId, reporterUserId], map: "job_reports_once_uq")
  @@index([jobId], map: "job_reports_job_idx")
  @@map("job_reports")
}

model JobStep {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  jobId     String   @db.Uuid @map("job_id")
  position  Int      @db.SmallInt
  body      String   @db.VarChar(300)
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @default(now()) @db.Timestamptz(6) @map("updated_at")
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([jobId, position], map: "job_steps_position_uq")
  @@map("job_steps")
}

model JobView {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  jobId         String   @db.Uuid @map("job_id")
  viewerUserId  String?  @db.Uuid @map("viewer_user_id")
  viewerKey     String   @db.VarChar(64) @map("viewer_key")
  firstViewedAt DateTime @default(now()) @db.Timestamptz(6) @map("first_viewed_at")
  lastViewedAt  DateTime @default(now()) @db.Timestamptz(6) @map("last_viewed_at")
  viewCount     Int      @default(1) @map("view_count")
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  viewerUser    User?    @relation(fields: [viewerUserId], references: [id], onUpdate: NoAction)

  @@unique([jobId, viewerKey], map: "job_views_viewer_uq")
  @@index([jobId, firstViewedAt], map: "job_views_job_day_idx")
  @@map("job_views")
}

model Job {
  id                      String                   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  publicId                String                   @unique @db.VarChar(12) @map("public_id")
  employerUserId          String                   @db.Uuid @map("employer_user_id")
  categoryId              String?                  @db.Uuid @map("category_id")
  title                   String                   @db.VarChar(80)
  timePerTask             TimePerTask              @default(about_5) @map("time_per_task")
  estMinutes              Int                      @default(5) @db.SmallInt @map("est_minutes")
  displayMinutes          Int                      @default(5) @db.SmallInt @map("display_minutes")
  openForDays             Int                      @default(7) @db.SmallInt @map("open_for_days")
  eligibility             JobEligibility           @default(all_verified)
  minApprovalRate         Int                      @default(80) @db.SmallInt @map("min_approval_rate")
  taskLinkUrl             String?                  @db.VarChar(2048) @map("task_link_url")
  proofInstructions       String?                  @db.VarChar(300) @map("proof_instructions")
  proofTypes              ProofType[]              @default([]) @map("proof_types")
  rules                   Json?
  rewardUsd               Decimal?                 @db.Decimal(20, 6) @map("reward_usd")
  slotsTotal              Int?                     @map("slots_total")
  platformFeePercent      Decimal                  @default(0) @db.Decimal(7, 4) @map("platform_fee_percent")
  feePerTaskUsd           Decimal                  @default(0) @db.Decimal(20, 6) @map("fee_per_task_usd")
  reviewWindowHours       Int                      @default(72) @db.SmallInt @map("review_window_hours")
  submissionsPerWorker    Int                      @default(1) @db.SmallInt @map("submissions_per_worker")
  allowResubmission       Boolean                  @default(true) @map("allow_resubmission")
  autoApprove             Boolean                  @default(true) @map("auto_approve")
  pauseOnLowDeposit       Boolean                  @default(true) @map("pause_on_low_deposit")
  status                  JobStatus                @default(draft)
  pauseReason             PauseReason?             @map("pause_reason")
  closeReason             CloseReason?             @map("close_reason")
  wizardStep              Int                      @default(1) @db.SmallInt @map("wizard_step")
  postingRulesAcceptedAt  DateTime?                @db.Timestamptz(6) @map("posting_rules_accepted_at")
  publishedAt             DateTime?                @db.Timestamptz(6) @map("published_at")
  endsAt                  DateTime?                @db.Timestamptz(6) @map("ends_at")
  pausedAt                DateTime?                @db.Timestamptz(6) @map("paused_at")
  closedAt                DateTime?                @db.Timestamptz(6) @map("closed_at")
  suspendedAt             DateTime?                @db.Timestamptz(6) @map("suspended_at")
  suspendedByAdminId      String?                  @db.Uuid @map("suspended_by_admin_id")
  suspensionReason        String?                  @db.VarChar(300) @map("suspension_reason")
  firstSubmissionAt       DateTime?                @db.Timestamptz(6) @map("first_submission_at")
  countActiveReservations Int                      @default(0) @map("count_active_reservations")
  countInReview           Int                      @default(0) @map("count_in_review")
  countNeedsFix           Int                      @default(0) @map("count_needs_fix")
  countApproved           Int                      @default(0) @map("count_approved")
  countRejected           Int                      @default(0) @map("count_rejected")
  countViews              Int                      @default(0) @map("count_views")
  countStarts             Int                      @default(0) @map("count_starts")
  slotsLeft               Int?                     @default(dbgenerated("((((COALESCE(slots_total, 0) - count_approved) - count_in_review) - count_needs_fix) - count_active_reservations)")) @map("slots_left")
  spentUsd                Decimal                  @default(0) @db.Decimal(20, 6) @map("spent_usd")
  reserveOutstandingUsd   Decimal                  @default(0) @db.Decimal(20, 6) @map("reserve_outstanding_usd")
  avgReviewSeconds        Int?                     @map("avg_review_seconds")
  avgCompletionSeconds    Int?                     @map("avg_completion_seconds")
  duplicatedFromJobId     String?                  @db.Uuid @map("duplicated_from_job_id")
  searchTsv               Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, (COALESCE(title, ''::character varying))::text)")) @map("search_tsv")
  version                 Int                      @default(1)
  deletedAt               DateTime?                @db.Timestamptz(6) @map("deleted_at")
  moderationFlags         Json?                  @map("moderation_flags")
  moderationFlaggedAt     DateTime?              @db.Timestamptz(6) @map("moderation_flagged_at")
  createdAt               DateTime                 @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt               DateTime                 @default(now()) @db.Timestamptz(6) @map("updated_at")
  jobProofRequirements    JobProofRequirement[]
  jobReports              JobReport[]
  jobSteps                JobStep[]
  jobViews                JobView[]
  category                Category?                @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  duplicatedFromJob       Job?                     @relation("jobsTojobs", fields: [duplicatedFromJobId], references: [id], onUpdate: NoAction)
  jobsByDuplicatedFromJob Job[]                    @relation("jobsTojobs")
  employerUser            User                     @relation(fields: [employerUserId], references: [id], onUpdate: NoAction)
  suspendedByAdmin        AdminUser?               @relation(fields: [suspendedByAdminId], references: [id], onUpdate: NoAction)
  ledgerTransactions      LedgerTransaction[]
  slotReservations        SlotReservation[]
  submissions             Submission[]

  @@index([proofTypes], map: "jobs_proof_types_gin", type: Gin)
  @@index([searchTsv], map: "jobs_search_gin", type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], map: "jobs_title_trgm", type: Gin)
  @@map("jobs")
}

model KycVerification {
  id                 String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId             String          @db.Uuid @map("user_id")
  documentType       KycDocumentType @map("document_type")
  status             KycStatus       @default(pending)
  frontUploadId      String          @db.Uuid @map("front_upload_id")
  backUploadId       String?         @db.Uuid @map("back_upload_id")
  selfieUploadId     String          @db.Uuid @map("selfie_upload_id")
  documentNumberEnc  Bytes           @map("document_number_enc")
  documentNumberHash Bytes           @map("document_number_hash")
  documentLast4      String          @db.VarChar(4) @map("document_last4")
  nameOnDocument     String?         @db.VarChar(80) @map("name_on_document")
  submittedAt        DateTime        @default(now()) @db.Timestamptz(6) @map("submitted_at")
  reviewDueAt        DateTime        @db.Timestamptz(6) @map("review_due_at")
  reviewedAt         DateTime?       @db.Timestamptz(6) @map("reviewed_at")
  reviewedByAdminId  String?         @db.Uuid @map("reviewed_by_admin_id")
  rejectionReasonCode KycRejectionReason? @map("rejection_reason_code")
  rejectionReason    String?         @db.VarChar(300) @map("rejection_reason")
  verifiedAt         DateTime?       @db.Timestamptz(6) @map("verified_at")
  retainUntil        DateTime?       @db.Timestamptz(6) @map("retain_until")
  purgedAt           DateTime?       @db.Timestamptz(6) @map("purged_at")
  dateOfBirthEnc        Bytes?                @map("date_of_birth_enc")
  createdAt          DateTime        @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt          DateTime        @default(now()) @db.Timestamptz(6) @map("updated_at")
  reviewedByAdmin    AdminUser?      @relation(fields: [reviewedByAdminId], references: [id], onUpdate: NoAction, map: "kyc_reviewed_by_fk")
  backUpload         Upload?         @relation("kyc_verifications_back_upload_idTouploads", fields: [backUploadId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  frontUpload        Upload          @relation("kyc_verifications_front_upload_idTouploads", fields: [frontUploadId], references: [id], onUpdate: NoAction)
  selfieUpload       Upload          @relation("kyc_verifications_selfie_upload_idTouploads", fields: [selfieUploadId], references: [id], onUpdate: NoAction)
  user               User            @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([documentNumberHash], map: "kyc_doc_hash_idx")
  @@index([userId, submittedAt(sort: Desc)], map: "kyc_user_idx")
  @@map("kyc_verifications")
}

model LedgerEntry {
  id            String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  transactionId String            @db.Uuid @map("transaction_id")
  txSeq         BigInt            @map("tx_seq")
  accountId     String            @db.Uuid @map("account_id")
  displayType   LedgerTxType      @map("display_type")
  amount        Decimal           @db.Decimal(20, 6)
  balanceAfter  Decimal?          @db.Decimal(20, 6) @map("balance_after")
  createdAt     DateTime          @default(now()) @db.Timestamptz(6) @map("created_at")
  account       WalletAccount     @relation(fields: [accountId], references: [id], onUpdate: NoAction)
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onUpdate: NoAction)

  @@unique([transactionId, accountId], map: "le_tx_account_uq")
  @@index([accountId, txSeq(sort: Desc)], map: "le_account_seq_idx")
  @@index([accountId, displayType, createdAt], map: "le_account_type_created_idx")
  @@index([transactionId], map: "le_transaction_idx")
  @@map("ledger_entries")
}

model LedgerTransaction {
  id                                    String                    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  seq                                   BigInt                    @unique @default(autoincrement())
  publicRef                             String?                   @unique @default(dbgenerated("fmt_ref('TX-'::text, seq, 5)")) @db.VarChar(12) @map("public_ref")
  type                                  LedgerTxType
  operationId                           String                    @db.Uuid @map("operation_id")
  idempotencyKey                        String                    @unique @db.VarChar(120) @map("idempotency_key")
  jobId                                 String?                   @db.Uuid @map("job_id")
  submissionId                          String?                   @db.Uuid @map("submission_id")
  depositId                             String?                   @db.Uuid @map("deposit_id")
  withdrawalId                          String?                   @db.Uuid @map("withdrawal_id")
  referralCommissionId                  String?                   @db.Uuid @map("referral_commission_id")
  disputeId                             String?                   @db.Uuid @map("dispute_id")
  reversesTxId                          String?                   @db.Uuid @map("reverses_tx_id")
  createdByActor                        ActorType                 @map("created_by_actor")
  createdByUserId                       String?                   @db.Uuid @map("created_by_user_id")
  createdByAdminId                      String?                   @db.Uuid @map("created_by_admin_id")
  approvedByAdminId                     String?                   @db.Uuid @map("approved_by_admin_id")
  reasonCode                            String?                   @db.VarChar(30) @map("reason_code")
  reason                                String?                   @db.VarChar(300)
  descriptionParams                     Json                      @default("{}") @map("description_params")
  occurredAt                            DateTime                  @default(now()) @db.Timestamptz(6) @map("occurred_at")
  depositsByCreditLedgerTx              Deposit[]                 @relation("deposits_credit_ledger_tx_idToledger_transactions")
  depositsByRefundLedgerTx              Deposit[]                 @relation("deposits_refund_ledger_tx_idToledger_transactions")
  disputesByPayoutLedgerTx              Dispute[]                 @relation("disputes_payout_ledger_tx_idToledger_transactions")
  ledgerAdjustmentRequests              LedgerAdjustmentRequest[]
  ledgerEntries                         LedgerEntry[]
  approvedByAdmin                       AdminUser?                @relation("ledger_transactions_approved_by_admin_idToadmin_users", fields: [approvedByAdminId], references: [id], onUpdate: NoAction)
  createdByAdmin                        AdminUser?                @relation("ledger_transactions_created_by_admin_idToadmin_users", fields: [createdByAdminId], references: [id], onUpdate: NoAction)
  createdByUser                         User?                     @relation(fields: [createdByUserId], references: [id], onUpdate: NoAction)
  dispute                               Dispute?                  @relation("ledger_transactions_dispute_idTodisputes", fields: [disputeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  job                                   Job?                      @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reversesTx                            LedgerTransaction?        @relation("ledger_transactionsToledger_transactions", fields: [reversesTxId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  ledgerTransactionsByReversesTx        LedgerTransaction[]       @relation("ledger_transactionsToledger_transactions")
  submission                            Submission?               @relation("ledger_transactions_submission_idTosubmissions", fields: [submissionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  deposit                               Deposit?                  @relation("ledger_transactions_deposit_idTodeposits", fields: [depositId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ltx_deposit_fk")
  referralCommission                    ReferralCommission?       @relation("ledger_transactions_referral_commission_idToreferral_commissions", fields: [referralCommissionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ltx_referral_commission_fk")
  withdrawal                            Withdrawal?               @relation("ledger_transactions_withdrawal_idTowithdrawals", fields: [withdrawalId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ltx_withdrawal_fk")
  providerSettlementLines               ProviderSettlementLine[]
  referralCommissionsByLedgerTx         ReferralCommission[]      @relation("referral_commissions_ledger_tx_idToledger_transactions")
  referralCommissionsByReversalLedgerTx ReferralCommission[]      @relation("referral_commissions_reversal_ledger_tx_idToledger_transactions")
  submissionsByPaidLedgerTx             Submission[]              @relation("submissions_paid_ledger_tx_idToledger_transactions")
  withdrawalsByRequestLedgerTx          Withdrawal[]              @relation("withdrawals_request_ledger_tx_idToledger_transactions")
  withdrawalsByReversalLedgerTx         Withdrawal[]              @relation("withdrawals_reversal_ledger_tx_idToledger_transactions")
  withdrawalsBySettleLedgerTx           Withdrawal[]              @relation("withdrawals_settle_ledger_tx_idToledger_transactions")

  @@index([operationId], map: "ltx_operation_idx")
  @@index([type, occurredAt], map: "ltx_type_posted_idx")
  @@map("ledger_transactions")
}

