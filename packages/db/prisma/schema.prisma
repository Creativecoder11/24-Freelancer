  updatedAt        DateTime         @default(now()) @db.Timestamptz(6) @map("updated_at")
  createdByAdmin   AdminUser        @relation(fields: [createdByAdminId], references: [id], onUpdate: NoAction)
  withdrawals      Withdrawal[]

  @@index([method, createdAt(sort: Desc)], map: "wb_method_idx")
  @@map("withdrawal_batches")
}

model WithdrawalQuote {
  id             String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId         String           @db.Uuid @map("user_id")
  payoutMethodId String?          @db.Uuid @map("payout_method_id")
  method         PayoutMethodType
  amountUsd      Decimal          @db.Decimal(20, 6) @map("amount_usd")
  feeUsd         Decimal          @db.Decimal(20, 6) @map("fee_usd")
  payoutCurrency String           @db.Char(4) @map("payout_currency")
  exchangeRateId String           @db.Uuid @map("exchange_rate_id")
  fxRate         Decimal          @db.Decimal(20, 6) @map("fx_rate")
  receiveAmount  Decimal          @db.Decimal(20, 6) @map("receive_amount")
  expiresAt      DateTime         @db.Timestamptz(6) @map("expires_at")
  consumedAt     DateTime?        @db.Timestamptz(6) @map("consumed_at")
  createdAt      DateTime         @default(now()) @db.Timestamptz(6) @map("created_at")
  exchangeRate   ExchangeRate     @relation(fields: [exchangeRateId], references: [id], onUpdate: NoAction)
  payoutMethod   PayoutMethod?    @relation(fields: [payoutMethodId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  withdrawals    Withdrawal[]

  @@index([expiresAt], map: "wq_expires_idx")
  @@index([userId, createdAt(sort: Desc)], map: "wq_user_idx")
  @@map("withdrawal_quotes")
}

enum ActiveMode {
  worker
  employer

  @@map("active_mode")
}

enum ActorType {
  user
  admin
  system

  @@map("actor_type")
}

enum AdminUserStatus {
